{
  "name": "online-learning-api",
  "version": "1.0.0",
  "private": true,
  "description": "BED411 online learning backend assignment",
  "main": "src/server.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check:openapi": "node scripts/check-openapi.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "prisma": "6.19.0",
    "supertest": "7.3.2"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.1",
      "deepmerge-ts": "8.0.0"
    }
  }
}
