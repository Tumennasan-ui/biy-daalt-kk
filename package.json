{
  "name": "online-learning-api",
  "version": "1.0.0",
  "private": true,
  "description": "BED411 online learning backend assignment",
  "main": "src/server.js",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:postman": "newman run postman_collection.json --env-var baseUrl=http://localhost:3000",
    "check:openapi": "node scripts/check-openapi.js"
  },
  "prisma": { "seed": "node prisma/seed.js" },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "newman": "6.2.1",
    "prisma": "6.19.0",
    "supertest": "7.2.2"
  }
}
